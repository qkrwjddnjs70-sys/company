# cp .env.example .env 로 복사한 뒤 실제 값으로 채우세요. .env 는 git에 올라가지 않습니다.

# developers.naver.com → 애플리케이션 등록 → '검색' API 사용 신청으로 발급받은 값
# (키워드 추이 조회 / 급상승 키워드 발견 탭에서 사용)
TRENDBOT_NAVER_CLIENT_ID=
TRENDBOT_NAVER_CLIENT_SECRET=

# searchad.naver.com 로그인 → 도구 → API 사용 관리 → 서비스 신청으로 발급받은 값
# (브랜드/세부 비교 탭에서 사용 — 위 데이터랩 키와는 완전히 다른 별도 계정/키)
TRENDBOT_SEARCHAD_API_KEY=
TRENDBOT_SEARCHAD_SECRET_KEY=
TRENDBOT_SEARCHAD_CUSTOMER_ID=
